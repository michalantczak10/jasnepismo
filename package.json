{
  "name": "jasnepismo",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "npx playwright test --reporter=html",
    "test:all": "npm run test:unit && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx,json,md,css,html,yml,yaml}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "formidable": "^3.0.0",
    "mammoth": "^1.4.19",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "adm-zip": "^0.5.9",
    "xml2js": "^0.6.2",
    "ioredis": "^5.3.2"
  },
  "optionalDependencies": {
    "bullmq": "^1.87.0"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=24"
  }
}
