{
  "name": "jasnepismo",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --test",
    "gen:sitemap": "node scripts/generate-sitemap.js",
    "lint": "eslint . --ext .js,.cjs --cache",
    "lint:fix": "eslint . --ext .js,.cjs --fix",
    "format": "prettier --write .",
    "ci": "npm run lint && npm test",
    "prepare": "node scripts/prepare-husky.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "eslint": "^9.23.0",
    "prettier": "^3.8.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "@playwright/test": "^1.60.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
