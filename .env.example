# Minimal environment example for jasnepismo
# Set required values in your hosting provider or environment.

# OpenAI API key for explanation feature (leave empty to disable AI features)
OPENAI_API_KEY=

# Optional: model to use (domyślnie: gpt-5-mini)
OPENAI_MODEL=

# Model zapasowy przy błędzie organizacji (domyślnie: gpt-3.5-turbo)
OPENAI_FALLBACK_MODEL=

# Timeout żądania w milisekundach (domyślnie: 20000)
OPENAI_REQUEST_TIMEOUT_MS=
