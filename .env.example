# === WYMAGANE ===
# Klucz API OpenAI — pobierz z https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# === OPCJONALNE ===

# Model OpenAI (domyślnie: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Model fallback gdy podstawowy jest niedostępny (domyślnie: gpt-4o-mini)
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Limit czasu na request do OpenAI w ms (domyślnie: 20000)
# OPENAI_REQUEST_TIMEOUT_MS=20000

# === RATE LIMITING ===
# Bez Redis — rate limiting działa w pamięci procesu (reset przy restarcie)
# Z Redis — trwały rate limiting, wymaga REDIS_URL
# Na Vercel — użyj Upstash Redis: https://console.upstash.com/

# REDIS_URL=redis://...
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# === OCR (opcjonalny) ===
# OCR działa lokalnie w api/explain przez tesseract.js, ograniczony do 1 zadania na raz.
# Dla wydajności na produkcji uruchom osobny OCR worker:

# URL workera OCR (jeśli uruchomiony osobno)
# OCR_WORKER_URL=https://twoj-ocr-worker.vercel.app

# Maksymalna liczba równoczesnych zadań OCR (domyślnie: 1)
# OCR_CONCURRENCY=1

# Limit czasu na pojedyńcze OCR w ms (domyślnie: 20000)
# OCR_TIMEOUT_MS=20000

# Limit czasu na worker OCR w ms (domyślnie: 20000)
# OCR_WORKER_TIMEOUT_MS=20000
