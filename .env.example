# Example environment variables for jasnepismo
# Copy to .env or set in your hosting provider (Vercel/Netlify/Heroku) or GitHub Actions secrets.

# Enable accurate token estimation using tiktoken (optional). Set to 1 to enable.
USE_TIKTOKEN=1

# OpenAI key (required for production)
OPENAI_API_KEY=

# Metrics scraping token (optional)
METRICS_TOKEN=

# Monitor admin token for /api/internal-health
MONITOR_ADMIN_TOKEN=

# Admin token for cache-status endpoint
ADMIN_API_TOKEN=

# Prompt and cache tuning
PROMPT_MAX_CHARS=1000
CACHE_MAX_ENTRIES=200
CACHE_TTL_MS=3600000
