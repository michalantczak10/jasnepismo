{
  "uid": "jasnepismo-token-metrics-extended",
  "title": "JasnePismo - Token Metrics (Extended)",
  "schemaVersion": 27,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cache hit rate (%)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "(sum(rate(jasnepismo_cache_hits[5m])) / (sum(rate(jasnepismo_cache_hits[5m])) + sum(rate(jasnepismo_cache_misses[5m])))) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens per minute (increase)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        { "expr": "increase(jasnepismo_tokens_total[1m])", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Last request - total tokens",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 },
      "targets": [
        { "expr": "jasnepismo_last_usage_total_tokens", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens - 7d total",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "targets": [
        { "expr": "increase(jasnepismo_tokens_total[7d])", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache size (items)",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 6 },
      "targets": [
        { "expr": "jasnepismo_cache_size", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cache max entries",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 6 },
      "targets": [
        { "expr": "jasnepismo_cache_max_entries", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "7d change vs previous 7d (%)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "(increase(jasnepismo_tokens_total[7d]) - increase(jasnepismo_tokens_total[7d] offset 7d)) / (increase(jasnepismo_tokens_total[7d] offset 7d) + 1) * 100",
          "refId": "A"
        }
      ]
    }
  ],
  "time": { "from": "now-7d", "to": "now" },
  "description": "Extended dashboard with tokens counter panels. Ensure jasnepismo_tokens_total is exposed as a counter from /api/metrics.",
  "tags": ["jasnepismo","tokens","cache"]
}