{
  "uid": "jasnepismo-token-comparison",
  "title": "JasnePismo - Token Comparison",
  "schemaVersion": 27,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tokens per minute (theoretical vs compressed vs actual)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        { "expr": "increase(jasnepismo_theoretical_tokens_total[1m])", "refId": "A", "legendFormat": "theoretical" },
        { "expr": "increase(jasnepismo_compressed_tokens_total[1m])", "refId": "B", "legendFormat": "compressed" },
        { "expr": "increase(jasnepismo_tokens_total[1m])", "refId": "C", "legendFormat": "actual" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "7d savings (%)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "(1 - (increase(jasnepismo_tokens_total[7d]) / (increase(jasnepismo_theoretical_tokens_total[7d]) + 1e-9))) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit rate (%)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "targets": [ { "expr": "(sum(rate(jasnepismo_cache_hits[5m])) / (sum(rate(jasnepismo_cache_hits[5m])) + sum(rate(jasnepismo_cache_misses[5m])))) * 100", "refId": "A" } ]
    }
  ],
  "time": { "from": "now-7d", "to": "now" },
  "description": "Compare theoretical (no compression) vs compressed vs actual token usage.",
  "tags": ["jasnepismo","tokens","comparison"]
}